# 复制为 .env 后修改；.env 已被 .gitignore，不会提交
IMAGE=ghcr.io/jjrexwang/jmdownloader-docker:latest
HOST_PORT=1180
CONFIG_PATH=./config
DOWNLOADS_PATH=./downloads
# 容器内运行用户。留空 = 自动从下载目录已有文件的属主推断（推荐：docker 自动适应
# 飞牛/NAS，指向已有漫画库时开箱即用，无需手动查 uid）；显式设置则优先使用。
# PGID 留空时默认与 PUID 相同。
# 例：PUID=1000
PUID=
PGID=
TZ=Asia/Shanghai
RUST_LOG=info
# JM 账号（可留空，之后在 WebUI 里登录）
JM_USERNAME=
JM_PASSWORD=
# WebUI Basic Auth（两项都填才开启；暴露到局域网外务必开启）
AUTH_USER=
AUTH_PASSWORD=
